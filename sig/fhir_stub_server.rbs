module FHIRStubServer
  VERSION: String

  def self.load: (String path) -> Stub
  def self.require_gem: (String name, String needed_by) -> void
  def self.read_file: (String path) -> String
  def self.parse_file: (String path, :json | :yaml format) -> untyped

  # What every adapter hands to Stub#respond.
  type request = {
    role: :fhir | :validator,
    method: String,
    base_url: String,
    path: String,
    query: Hash[String, Array[String]],
    body: String?
  }

  # What an adapter reads off its transport, before Request.build normalizes it.
  type raw_request = {
    role: :fhir | :validator,
    method: String,
    base_url: String,
    path: String,
    query: String,
    body: String?
  }

  # Rack-style [status, headers, body].
  type response = [Integer, Hash[String, String], String]

  type resource = Hash[String, untyped]

  # A Pair as Stub#unused_pairs lists it: where it is written and its request as the config writes it.
  type unused_pair = { role: :fhir | :validator, pair: String, request: Hash[String, untyped] }

  # A `select` or `include` that yielded nothing, as Stub#empty_selects lists it.
  type empty_select = { role: :fhir, pair: String, expression: String }

  class Error < StandardError
  end

  class Stub
    def initialize: (Hash[String, untyped] config, ?dir: String) -> void
    def served: () -> Array[Hash[Symbol, untyped]]
    def unmatched: () -> Array[Hash[Symbol, untyped]]
    def context_mismatches: () -> Array[Hash[Symbol, untyped]]
    def unmatched_report: () -> String
    def unused_pairs: () -> Array[unused_pair]
    def unused_pairs_report: () -> String
    def empty_selects: () -> Array[empty_select]
    def validator?: () -> bool
    def respond: (request request) -> response

    @validator: bool
    @roles: { fhir: FHIRRole, validator: Validator }
    @reports: Hash[Symbol, Array[Hash[Symbol, untyped]]]
  end

  # What a role answers a request with: what answered it (where the Pair is written, :demo_data or :miss),
  # the response and the report entries to append, by report name.
  type answer = [String | Symbol, response, Hash[Symbol, Array[Hash[Symbol, untyped]]]]

  class FHIRRole
    @pairs: Array[Pairs::pair]
    @reads: Hash[String, resource]

    def initialize: (Hash[String, untyped] config, Hash[String, resource] demo_data, String model, String dir) -> void
    def answer: (request request) -> answer
    def pairs: () -> Array[unused_pair]
    def empty_selects: () -> Array[empty_select]
    def self.listed: (Array[Pairs::pair] pairs) -> Array[unused_pair]
    def self.config: (Request::key key) -> Hash[String, untyped]
    def self.config_values: (Hash[String, Array[String]]? params) -> Hash[String, String | Array[String]]?
    def self.read_path: (request request) -> String?

    private

    def read_answer: (request request) -> [Symbol, response]?
  end

  module Pairs
    type body = ^(request request, Paging::page page) -> String?
    type pair = { key: Request::key, status: Integer, body: body, where: String, empty_selects: Array[empty_select] }
    # Evaluates a FHIRPath expression over all Demo Data.
    type fhirpath = ^(String expression) -> Array[untyped]
    # Query and form values, or (for `body`) JSON bodies.
    type differences = Hash[String, { expected: untyped, actual: untyped }]

    BODY_KINDS: Array[String]

    def self.load: (Array[Hash[String, untyped]] pairs, fhirpath fhirpath, String dir) -> Array[pair]
    def self.fhirpath: (Hash[String, resource] demo_data, String model) -> fhirpath
    def self.with_dir: (Hash[String, untyped] pair, String dir) -> Hash[String, untyped]
    def self.answer: (Array[pair] pairs, request request) -> [String, response]?
    def self.near_miss: (Array[pair] pairs, request request) -> { nearest_pair: String?, differences: differences }
    def self.candidates: (Array[pair] pairs, Request::key key) -> Array[[String, differences]]
    def self.differences: (Request::key pair_key, Request::key request_key) -> differences
    def self.diff: (Hash[String, Array[String]] expected, Hash[String, Array[String]] actual) -> differences
    def self.json_diff: (Request::json? expected, Request::json? actual) -> differences
    def self.build: (Hash[String, untyped] pair, fhirpath fhirpath, String where) -> pair
    def self.body: (Hash[String, untyped] config, fhirpath fhirpath, String where) -> [body, Array[empty_select]]
    def self.empty_selects: (Hash[String, untyped] config, Hash[String, Array[resource]] results, String where) -> Array[empty_select]
    def self.literal_body: (Hash[String, untyped] config, fhirpath fhirpath, String where) -> body
    def self.body_kind: (Hash[String, untyped] config, String where) -> String?
    def self.evaluate: (String? expression, fhirpath fhirpath, String where) -> Array[resource]
    def self.resources_only: (Array[untyped] results, String label) -> Array[resource]
    def self.one_resource: (Array[resource] results, String where) -> resource
  end

  class Includes
    # [pair as written, dir of its file, where it is written]
    type spliced = [untyped, String, String]
    # [file holding the entry (nil: the config itself), index], for each entry leading to a Pair
    type trail = Array[[String?, Integer]]

    @name: String
    @root: String

    def self.splice: (Array[untyped] entries, String name, String dir) -> Array[spliced]
    def initialize: (String name, String dir) -> void
    def pairs: (Array[untyped] entries, ?String? file, ?trail trail) -> Array[spliced]

    private

    def entry_pairs: (untyped entry, String dir, trail at) -> Array[spliced]
    def from_path: (Hash[String, untyped] include, String dir, trail at) -> String
    def included: (String file, trail at) -> Array[spliced]
    def read: (String file, trail at) -> untyped
    def where: (trail at) -> String
    def relative: (String file) -> String
  end

  module Request
    # What a request and a Pair must share to match; queries are { name => sorted values }, `json`
    # a JSON object or array, or the body as it is when it is neither.
    type key = { method: String, path: String, query: Hash[String, Array[String]], form: Hash[String, Array[String]]?,
                 json: json? }
    type json = Hash[String, untyped] | Array[untyped] | String

    METHODS: Array[String]
    JSON_WRITES: Array[String]

    def self.build: (raw_request raw) -> request
    def self.pair: (Hash[String, untyped] config, String where) -> request
    def self.pair_body: (untyped body, { method: String, path: String } request, String where) -> String
    def self.parse_query: (String query) -> Hash[String, Array[String]]
    def self.key: (request request) -> key
    def self.match?: (key pair_key, key key) -> bool
    def self.search?: (request | { method: String, path: String } request) -> bool
    def self.json: (String? body) -> json?
  end

  module Paging
    # The total of all matches, and each page's [matches, includes].
    type pages = { total: Integer, entries: Array[[Array[resource], Array[resource]]] }

    type page = { number: Integer, path: String }

    PATH: Regexp

    def self.locate: (Array[Pairs::pair] pairs, Request::key key) -> [Integer, page]?
    def self.continued: (Request::key key) -> [Integer, page]?
    def self.page: (Integer index, Integer number) -> [Integer, page]
    def self.body: (Hash[String, untyped] config, Hash[String, Array[resource]] results, String where) -> Pairs::body
    def self.size: (Hash[String, untyped] config, Array[resource] matches, String where) -> Integer
    def self.split: (Array[resource] matches, Array[resource] includes, Integer size) -> pages
  end

  module Responses
    CONTENT_TYPE: String

    def self.fhir: (Integer status, resource resource) -> response
    def self.raw: (Integer status, String body) -> response
    def self.searchset: (request request, Paging::pages pages, Paging::page page) -> String?
    def self.links: (request request, String? next_url) -> Array[Hash[String, String]]
    def self.entries: (String base_url, Array[resource] resources, String mode) -> Array[Hash[String, untyped]]
    def self.validation: (Array[untyped] issues) -> response
    def self.not_found: (request request) -> response
  end

  module Sources
    type located = [String, resource]
    # [package path, the FHIR versions its package.json states]
    type stated = [String, Array[untyped]]

    MODELS: Hash[String, String]

    def self.load: (Array[Hash[String, String]] sources, String dir) -> [Hash[String, resource], Array[Hash[Symbol, untyped]], String]
    def self.model: (Array[stated] stated) -> String
    def self.no_common_version: (Array[stated] stated) -> Error
    def self.models: (String path, Array[untyped] versions) -> Array[String]
    def self.index: (Array[located] located) -> Hash[String, resource]
    def self.skipped_entries: (Array[located] skipped) -> Array[Hash[Symbol, untyped]]
    def self.reads: (Hash[String, resource] demo_data) -> Hash[String, resource]
    def self.server_capability_statement: (Array[resource] resources) -> resource?
    def self.server?: (resource resource) -> bool
    def self.key: (resource resource) -> String
    def self.located_resources: (Hash[String, String] source, String dir) -> [Array[located], stated?]
    def self.package_resources: (String path) -> [Array[located], stated]
    def self.json_files: (String path) -> Array[[String, Hash[String, untyped]]]
    def self.tar_json_files: (Zlib::GzipReader archive) -> Array[[String, Hash[String, untyped]]]
    def self.json: (Gem::Package::TarReader::Entry entry) -> untyped
    def self.bundle_resources: (String path) -> Array[located]
    def self.no_duplicates: (Array[located] located) -> Array[located]
    def self.duplicate: (Array[located] located) -> [String, Array[located]]?
  end

  class Validator
    type key = [String?, String?]
    type mismatch = { request: request, key: String, expected: untyped, actual: untyped }

    @pairs: Array[[key, Array[untyped], String]]
    @expected_context: Hash[String, untyped]

    def initialize: (Hash[String, untyped] config, String dir) -> void
    def answer: (request request) -> answer
    def pairs: () -> Array[unused_pair]
    def self.call: (request request) -> [key, Hash[String, untyped]]?
    def self.key: (Hash[String, untyped] file) -> key
    def self.miss: (request request, key? key) -> Hash[Symbol, untyped]
    def self.config: (key key) -> Hash[String, String]

    private

    def matching_pair: (key? key) -> [key, Array[untyped], String]?
    def mismatches: (Hash[String, untyped]? context, request request) -> Array[mismatch]
  end

  class RackApp
    @stub: Stub
    @base_paths: Hash[:fhir | :validator, String]

    def initialize: (Stub stub, ?fhir_base_path: String, ?validator_base_path: String) -> void
    def call: (Hash[String, untyped] env) -> [Integer, Hash[String, String], Array[String]]
    def base_path_for: (String path) -> [:fhir | :validator, String]?
    def self.stub_request: (Hash[String, untyped] env, :fhir | :validator role, String base_path) -> request
  end

  module Unmatched
    def self.describe: (Hash[Symbol, untyped] miss) -> String
    def self.differences: (Pairs::differences differences) -> String
    def self.suggestion: (Hash[Symbol, untyped] miss) -> String
  end

  class Replay
    @stub: Stub
    @rack_app: RackApp
    @log: IO
    @lock: Thread::Mutex

    def initialize: (Stub stub, ?IO log) -> void
    def call: (Hash[String, untyped] env) -> [Integer, Hash[String, String], Array[String]]
    def log_unused_pairs: () -> void

    private

    def logging_misses: () { () -> [Integer, Hash[String, String], Array[String]] } -> [Integer, Hash[String, String], Array[String]]
  end

  # What Puma and HTTPServer need of a Rack app.
  interface _RackApp
    def call: (Hash[String, untyped] env) -> [Integer, Hash[String, String], Array[String]]
  end

  class HTTPServer
    @server: Puma::Server
    @thread: Thread?

    def initialize: (Stub | _RackApp stub_or_app, **String rack_app_options) -> void
    def start: () -> String
    def wait: () -> void
    def stop: () -> void
  end

  module WebMockAdapter
    self.@previous_notation: Symbol?

    def self.install: (Stub stub, fhir_base_url: String, ?validator_base_url: String?) -> void
    def self.uninstall: () -> void
    def self.keep_repeated_query_parameters: () -> void
    def self.route: (Stub stub, :fhir | :validator role, String base_url) -> void
    def self.stub_request: (untyped request, :fhir | :validator role, String base_url) -> request
  end
end
