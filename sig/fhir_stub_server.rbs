module FHIRStubServer
  VERSION: String

  def self.load: (String path) -> Stub
  def self.with_paths: (Hash[String, untyped] config, String dir) -> Hash[String, untyped]
  def self.with_body_paths: (Array[Hash[String, untyped]] pairs, String dir) -> Array[Hash[String, untyped]]
  def self.expand: (Hash[String, untyped] hash, String dir, *String keys) -> Hash[String, untyped]
  def self.require_gem: (String name, String needed_by) -> void
  def self.read_file: (String path) -> String
  def self.parse_file: (String path, :json | :yaml format) -> untyped

  # What every adapter hands to Stub#respond.
  type request = {
    role: :fhir | :validator,
    method: String,
    base_url: String,
    path: String,
    query: Hash[String, Array[String]],
    body: String?
  }

  # What an adapter reads off its transport, before Stub.request normalizes it.
  type raw_request = {
    role: :fhir | :validator,
    method: String,
    base_url: String,
    path: String,
    query: String,
    body: String?
  }

  # Rack-style [status, headers, body].
  type response = [Integer, Hash[String, String], String]

  type resource = Hash[String, untyped]

  class Error < StandardError
  end

  class Stub
    def initialize: (Hash[String, untyped] config) -> void
    def served: () -> Array[Hash[Symbol, untyped]]
    def unmatched: () -> Array[Hash[Symbol, untyped]]
    def context_mismatches: () -> Array[Validator::mismatch]
    def validator?: () -> bool
    def respond: (request request) -> response
    def self.request: (raw_request raw) -> request
    def self.parse_query: (String query) -> Hash[String, Array[String]]
    def self.read_path: (request request) -> String?

    @reads: Hash[String, resource]
    @pairs: Array[Pairs::pair]
    @validator: Validator::validator?
    @reports: { served: Array[Hash[Symbol, untyped]], unmatched: Array[Hash[Symbol, untyped]], context_mismatches: Array[Validator::mismatch] }

    private

    def answer: (request request) -> [Integer | Symbol, response]
    def validator_answer: (request request) -> [Integer, response]?
    def pair_answer: (request request) -> [Integer, response]?
    def pair_index: (request request) -> Integer?
    def read_answer: (request request) -> [Symbol, response]?
  end

  module Pairs
    type key = [Symbol, String, String, Hash[String, Array[String]], Hash[String, Array[String]]?]
    type pair = { key: key, status: Integer, body: ^(request) -> String }
    type differences = Hash[String, { expected: Array[String]?, actual: Array[String]? }]

    BODY_KINDS: Array[String]

    def self.load: (Array[Hash[String, untyped]] pairs, Hash[String, resource] demo_data) -> Array[pair]
    def self.key: (request request) -> key
    def self.near_miss: (Array[pair] pairs, request request) -> { nearest_pair: Integer?, differences: differences }
    def self.candidates: (Array[pair] pairs, key key) -> Array[[Integer, differences]]
    def self.differences: (key pair_key, key request_key) -> differences
    def self.diff: (Hash[String, Array[String]] expected, Hash[String, Array[String]] actual) -> differences
    def self.build: (Hash[String, untyped] pair, resource bundle, String where) -> pair
    def self.request: (Hash[String, untyped] config, String where) -> request
    def self.body: (Hash[String, untyped] config, resource bundle, String where) -> ^(request) -> String
    def self.literal_body: (Hash[String, untyped] config, resource bundle, String where) -> ^(request) -> String
    def self.body_kind: (Hash[String, untyped] config, String where) -> String?
    def self.evaluate: (String? expression, resource bundle, String where) -> Array[resource]
    def self.resources_only: (Array[untyped] results, String label) -> Array[resource]
    def self.one_resource: (Array[resource] results, String where) -> resource
  end

  module Responses
    CONTENT_TYPE: String

    def self.fhir: (Integer status, resource resource) -> response
    def self.raw: (Integer status, String body) -> response
    def self.searchset: (request request, Array[resource] matches, Array[resource] includes) -> String
    def self.entries: (String base_url, Array[resource] resources, String mode) -> Array[Hash[String, untyped]]
    def self.validation: (Array[untyped] issues) -> response
    def self.not_found: (request request) -> response
  end

  module Sources
    type located = [String, resource]

    def self.load: (Array[Hash[String, String]] sources) -> [Hash[String, resource], Array[Hash[Symbol, untyped]]]
    def self.index: (Array[located] located) -> Hash[String, resource]
    def self.skipped_entry: (String location) -> Hash[Symbol, untyped]
    def self.reads: (Hash[String, resource] demo_data) -> Hash[String, resource]
    def self.server_capability_statement: (Array[resource] resources) -> resource?
    def self.server?: (resource resource) -> bool
    def self.key: (resource resource) -> String
    def self.located_resources: (Hash[String, String] source) -> Array[located]
    def self.package_resources: (String path) -> Array[located]
    def self.tar_resources: (String path, Zlib::GzipReader archive) -> Array[located]
    def self.package_resource: (String path, Gem::Package::TarReader::Entry entry) -> located?
    def self.json: (Gem::Package::TarReader::Entry entry) -> untyped
    def self.bundle_resources: (String path) -> Array[located]
    def self.no_duplicates: (Array[located] located) -> Array[located]
    def self.duplicate: (Array[located] located) -> [String, Array[located]]?
  end

  module Validator
    type key = [String?, String?]
    type validator = { pairs: Array[[key, Array[untyped]]], expected_context: Hash[String, untyped] }
    type mismatch = { request: request, key: String, expected: untyped, actual: untyped }

    def self.load: (Hash[String, untyped] config) -> validator
    def self.match: (validator validator, request request) -> [Integer?, Array[mismatch]]
    def self.call: (request request) -> [key, Hash[String, untyped]]?
    def self.key: (Hash[String, untyped] file) -> key
    def self.mismatches: (Hash[String, untyped] expected_context, Hash[String, untyped] context, request request) -> Array[mismatch]
  end

  class RackApp
    @stub: Stub
    @base_paths: Hash[:fhir | :validator, String]

    def initialize: (Stub stub, ?fhir_base_path: String, ?validator_base_path: String) -> void
    def call: (Hash[String, untyped] env) -> [Integer, Hash[String, String], Array[String]]
    def base_path_for: (String path) -> [:fhir | :validator, String]?
    def self.stub_request: (Hash[String, untyped] env, :fhir | :validator role, String base_path) -> request
  end

  class Replay
    @rack_app: RackApp
    @unmatched: Array[Hash[Symbol, untyped]]
    @log: IO
    @lock: Thread::Mutex

    def initialize: (Stub stub, ?IO log) -> void
    def call: (Hash[String, untyped] env) -> [Integer, Hash[String, String], Array[String]]
    def self.describe: (Hash[Symbol, untyped] miss) -> String
    def self.differences: (Pairs::differences differences) -> String

    private

    def logging_misses: () { () -> [Integer, Hash[String, String], Array[String]] } -> [Integer, Hash[String, String], Array[String]]
  end

  class HTTPServer
    @server: Puma::Server

    def initialize: (Stub stub, **String rack_app_options) -> void
    def start: () -> String
    def stop: () -> void
  end

  module WebMockAdapter
    def self.install: (Stub stub, fhir_base_url: String, ?validator_base_url: String?) -> void
    def self.route: (Stub stub, :fhir | :validator role, String base_url) -> void
    def self.stub_request: (untyped request, :fhir | :validator role, String base_url) -> request
  end
end
