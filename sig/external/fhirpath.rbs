# The part of fhirpath-rb's API Pairs uses: fhirpath-rb ships no signatures.
# Kept out of the packaged gem.
module Fhirpath
  def self.evaluate: (Hash[String, untyped] resource, String expression, ?Hash[String, untyped] context, ?String? model) -> Array[untyped]

  class Error < StandardError
  end
end
