# The part of webmock's API the adapter uses: webmock ships no signatures.
# Kept out of the packaged gem.
module WebMock
  def self.enable!: () -> void
  def self.stub_request: (Symbol method, Regexp uri) -> RequestStub

  class Config
    def self.instance: () -> Config
    attr_accessor query_values_notation: Symbol?
  end

  class RequestStub
    def to_return: () { (untyped request) -> Hash[Symbol, untyped] } -> self
  end
end
